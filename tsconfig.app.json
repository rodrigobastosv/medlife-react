{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "target": "es2023",
    "lib": ["ES2023", "DOM"],
    "module": "esnext",
    "types": ["vite/client"],
    "allowArbitraryExtensions": true,
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",

    /* Path alias — mirrored in vite.config.ts.
       No `baseUrl`: it is deprecated in TypeScript 6, and `paths` entries are
       resolved relative to this file on their own. */
    "paths": { "@/*": ["./src/*"] },

    /* Type safety.
       `strict` is the baseline. The two extras matter for this codebase:
       - noUncheckedIndexedAccess: `array[0]` is typed `T | undefined`, which is
         the truth — it kills the class of crash where an empty list is indexed.
       - exactOptionalPropertyTypes: `{ notes?: string }` cannot be handed an
         explicit `undefined`, so "absent" and "present but undefined" stay
         distinct — the same distinction Dart draws between a missing named
         argument and a null one. */
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitOverride": true
  },
  "include": ["src"]
}
