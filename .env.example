# Copy to .env and fill in with your Supabase project's credentials.
#
# Only variables prefixed with VITE_ reach the browser, and they are inlined into
# the bundle at build time — treat them as public. That is fine for the
# publishable key, which is designed to be public; what protects the data is
# row-level security. Never put a service_role key here.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
