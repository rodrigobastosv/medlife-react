# Copy to .env and fill in with your Supabase project's credentials.
#
# Only variables prefixed with VITE_ reach the browser, and they are inlined into
# the bundle at build time — treat them as public. That is fine for the
# publishable key, which is designed to be public; what protects the data is
# row-level security. Never put a service_role key here.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# The VAPID *public* key, used to subscribe a browser to push notifications.
# Public in the same sense as the key above — it is what the push service checks
# a message's signature against, and it is meant to ship to every client. The
# matching PRIVATE key is an Edge Function secret (`supabase secrets set`) and
# must never appear here: anything prefixed VITE_ is inlined into a public
# bundle. Generate the pair with the command in the README.
# Leave it empty and the app still runs — the notification card just says push
# is not configured.
VITE_VAPID_PUBLIC_KEY=
