# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# Service worker built by vite-plugin-pwa when devOptions.enabled is on
dev-dist

# Editor directories and files
.vscode/*
# These two are shared, not personal: they are what stops the editor reporting
# errors on the Deno functions and the Tailwind v4 stylesheet.
!.vscode/extensions.json
!.vscode/settings.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Local env (contains the Supabase keys)
.env

# The VAPID key pair. The private half signs every push message, and it is
# uploaded to Supabase as a function secret — it must never be committed.
# Losing it is not fatal but is not free either: generating a new pair
# invalidates every existing subscription, and subscribed browsers go silent
# without an error anywhere. Keep a copy somewhere you will still have it.
.vapid.json

# The shared secret pg_cron sends to the notify function. Without it the
# function is a public endpoint anyone can fire.
.notify-secret.txt


# Supabase CLI scratch state (which project ref is linked, etc.)
supabase/.temp

# Playwright output. The report and traces are build artefacts of a run, and the
# browser cache is hundreds of megabytes.
/test-results
/playwright-report
/blob-report
/playwright/.cache
